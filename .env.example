# Environment variables consumed by skardi-server in this Railway template.
# On Railway, declare these in the service's Variables panel — the template
# composer will surface them to users at deploy time.

# ---- Required (auto-injected by Railway) ----
# PORT          HTTP port the server binds to. Railway sets this for you.

# ---- Volume / storage ----
# DATA_DIR      Mount path for the persistent SQLite database. The entrypoint
#               creates it on first boot and copies the seed DB there.
# DATA_DIR=/data

# ---- Optional: session auth (better-auth) ----
# Leave AUTH_MODE unset to keep all pipeline endpoints open. To require sign-in,
# set AUTH_MODE plus the three companion variables below.
# AUTH_MODE=BETTER_AUTH_DIESEL_SQLITE

# Signing key for sessions. Must be at least 32 characters. On Railway, set
# this to ${{ secret(48) }} so the value is generated once at deploy and not
# visible to template users.
# AUTH_SECRET=

# Path to the auth SQLite database. Put it on the volume so accounts survive
# redeploys. The template's entrypoint defaults this to ${DATA_DIR}/auth.db
# whenever AUTH_MODE is set, so you usually don't need to override.
# AUTH_DB_PATH=/data/auth.db

# Public origin used in auth callbacks / cookies. Set to your Railway public
# domain (with scheme). On Railway, ${{ RAILWAY_PUBLIC_DOMAIN }} resolves to
# the assigned host.
# AUTH_BASE_URL=https://${{ RAILWAY_PUBLIC_DOMAIN }}

# ---- Optional: logging ----
# RUST_LOG      tracing-subscriber filter. Examples: "info", "skardi=debug,info".
# RUST_LOG=info
